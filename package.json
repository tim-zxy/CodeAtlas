{
  "name": "codeatlas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "node --test scripts/test-workspace-structure.mjs apps/cli/test/smoke.test.mjs apps/mcp/test/smoke.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:rust": "cargo fmt --all",
    "format:rust:check": "cargo fmt --all --check",
    "verify": "pnpm format:check && pnpm build && pnpm test && pnpm format:rust:check && cargo build --workspace && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
