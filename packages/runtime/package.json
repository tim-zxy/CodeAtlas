{
  "name": "@codeatlas/runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:native-refresh-verification": "node --test --test-concurrency=1 test/native-refresh-verification.test.mjs test/native-refresh-verification-memory.test.mjs",
    "test:native-bootstrap": "node --test --test-concurrency=1 test/native-full-bootstrap.test.mjs",
    "test:native-metadata": "node --test --test-concurrency=1 test/native-analysis-state-read.test.mjs test/native-metadata-admission.test.mjs test/native-metadata-corpus.test.mjs ../storage/test/native-summary-stage.test.mjs",
    "bench:native-metadata": "node ../../scripts/bench-native-metadata-memory.mjs"
  },
  "dependencies": {
    "@codeatlas/application": "workspace:*",
    "@codeatlas/providers": "workspace:*",
    "@codeatlas/storage": "workspace:*"
  }
}
